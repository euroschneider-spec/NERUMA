# Configure only a new, dedicated VIANORAE Supabase project after review.
# Missing configuration leaves real registration/sign-in explicitly inactive.
VIANORAE_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VIANORAE_WORKSPACE_ENABLED=0
# Public address used in confirmation emails, e.g. https://neruma.lignorae.com. Unset: the request Origin is used.
VIANORAE_SITE_URL=
# No service_role key is needed by the account flow.
# Payments (docs/guides/PAYMENTS.md). All four, or Plan & billing stays hidden. Test keys (sk_test_) take no real money.
VIANORAE_STRIPE_SECRET_KEY=
VIANORAE_STRIPE_WEBHOOK_SECRET=
VIANORAE_STRIPE_PRICE_ID=
# 64 random hex characters (openssl rand -hex 32); its SHA-256 goes into private.billing_policy.
VIANORAE_BILLING_SECRET=
