{
  "name": "vianorae-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-database.mjs",
    "test:data": "node scripts/test-synthetic-data.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:db && npm run test:data && npm run check:deployment && npm run build",
    "check:deployment": "node scripts/check-deployment-files.mjs",
    "test:workspace": "node scripts/test-workspace.mjs",
    "test:smoke": "playwright test tests/smoke.spec.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "ignore": "5.3.2",
    "jsdom": "^30.1.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "overrides": {
    "playwright": "1.58.2",
    "playwright-core": "1.58.2"
  }
}
